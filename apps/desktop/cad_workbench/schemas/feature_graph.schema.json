{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CAD Studio Feature Graph IR v0.2",
  "description": "确定性特征图中间表示: 草图锚点(平面或 SelectionSpec) + 拉伸/切除/旋转/圆角/倒角/线性阵列; 长度单位一律毫米, 角度单位度。revolve 的轴与 linear_pattern 的方向实体是草图中的唯一构造中心线 (centerline)。引用锚点 (face_anchor/边线) 不保证上游编辑后存活 (重建语义)。",
  "type": "object",
  "required": ["schemaVersion", "name", "features"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.1"},
    "name": {"type": "string", "minLength": 1},
    "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/feature"}}
  },
  "definitions": {
    "selectionSpec": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["coordinate", "plane", "face", "named", "edge"]},
        "name": {"type": "string"},
        "feature": {"type": "string", "description": "限定候选所属特征名"},
        "geometry_signature": {"type": "string", "description": "期望几何签名, 不匹配时判 not_found"},
        "point_mm": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "nth": {"type": "integer", "minimum": 0, "description": "同类候选序号 (0 起)"},
        "entity_type": {"type": "string", "description": "覆盖 SolidWorks 选择类型串"}
      }
    },
    "rectangle": {
      "type": "object",
      "required": ["type", "x1", "y1", "x2", "y2"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "rectangle"},
        "x1": {"type": "number"}, "y1": {"type": "number"},
        "x2": {"type": "number"}, "y2": {"type": "number"}
      }
    },
    "centerline": {
      "type": "object",
      "required": ["type", "x1", "y1", "x2", "y2"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "centerline"},
        "x1": {"type": "number"}, "y1": {"type": "number"},
        "x2": {"type": "number"}, "y2": {"type": "number"}
      },
      "description": "构造中心线: revolve 的旋转轴 / linear_pattern 的方向实体, 每个相关草图恰含 1 条"
    },
    "circle": {
      "type": "object",
      "required": ["type", "cx", "cy", "r"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "circle"},
        "cx": {"type": "number"}, "cy": {"type": "number"}, "r": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "circle_array": {
      "type": "object",
      "required": ["type", "cx", "cy", "orbit_mm", "r_hole_mm", "count"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "circle_array"},
        "cx": {"type": "number"}, "cy": {"type": "number"},
        "orbit_mm": {"type": "number", "exclusiveMinimum": 0},
        "r_hole_mm": {"type": "number", "exclusiveMinimum": 0},
        "count": {"type": "integer", "minimum": 2},
        "start_angle_deg": {"type": "number", "default": 0}
      }
    },
    "shape": {
      "oneOf": [
        {"$ref": "#/definitions/rectangle"},
        {"$ref": "#/definitions/centerline"},
        {"$ref": "#/definitions/circle"},
        {"$ref": "#/definitions/circle_array"}
      ]
    },
    "sketch": {
      "type": "object",
      "required": ["shapes"],
      "additionalProperties": false,
      "properties": {
        "plane": {"type": "string", "description": "基准面名称; 与 face_anchor 二选一"},
        "face_anchor": {"$ref": "#/definitions/selectionSpec"},
        "shapes": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/shape"}}
      }
    },
    "extrude_boss": {
      "type": "object",
      "required": ["id", "op", "sketch", "depth_mm"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "op": {"const": "extrude_boss"},
        "sketch": {"$ref": "#/definitions/sketch"},
        "depth_mm": {"type": "number", "exclusiveMinimum": 0},
        "midplane": {"type": "boolean", "default": false},
        "flip": {"type": "boolean", "default": false, "description": "面上草图默认拉伸方向可能反向, 显式翻转"}
      }
    },
    "extrude_cut": {
      "type": "object",
      "required": ["id", "op", "sketch"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "op": {"const": "extrude_cut"},
        "sketch": {"$ref": "#/definitions/sketch"},
        "depth_mm": {"type": "number", "exclusiveMinimum": 0},
        "through_all": {"type": "boolean", "default": false},
        "flip": {"type": "boolean", "default": false}
      }
    },
    "revolve_boss": {
      "type": "object",
      "required": ["id", "op", "sketch"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "op": {"const": "revolve_boss"},
        "sketch": {"$ref": "#/definitions/sketch", "description": "草图必须恰含 1 条 centerline 作旋转轴"},
        "angle_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 360, "default": 360}
      }
    },
    "fillet": {
      "type": "object",
      "required": ["id", "op", "radius_mm", "edges"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "op": {"const": "fillet"},
        "radius_mm": {"type": "number", "exclusiveMinimum": 0},
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/selectionSpec"},
          "description": "目标边 edge SelectionSpec 列表; 歧义或未命中即停, 绝不猜测"
        }
      }
    },
    "chamfer": {
      "type": "object",
      "required": ["id", "op", "distance_mm", "edges"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "op": {"const": "chamfer"},
        "distance_mm": {"type": "number", "exclusiveMinimum": 0},
        "angle_deg": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90, "default": 45},
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/selectionSpec"}
        }
      }
    },
    "linear_pattern": {
      "type": "object",
      "required": ["id", "op", "target", "direction", "spacing_mm", "count"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "op": {"const": "linear_pattern"},
        "target": {"type": "string", "description": "被阵列特征的 id"},
        "direction": {
          "type": "object",
          "required": ["sketch"],
          "additionalProperties": false,
          "properties": {
            "sketch": {"type": "string", "description": "先前带草图特征的 id; 其草图恰含 1 条 centerline 作方向实体"}
          }
        },
        "spacing_mm": {"type": "number", "exclusiveMinimum": 0},
        "count": {"type": "integer", "minimum": 2}
      }
    },
    "feature": {
      "oneOf": [
        {"$ref": "#/definitions/extrude_boss"},
        {"$ref": "#/definitions/extrude_cut"},
        {"$ref": "#/definitions/revolve_boss"},
        {"$ref": "#/definitions/fillet"},
        {"$ref": "#/definitions/chamfer"},
        {"$ref": "#/definitions/linear_pattern"}
      ]
    }
  }
}
